# Persistent state (database + config + generated dashboard snapshot)
PROSPECTOR_DATA_DIR=/var/lib/prospector-dashboard

# Bind only to loopback; expose through the VPS reverse proxy.
PROSPECTOR_HOST=127.0.0.1
PROSPECTOR_PORT=8765

# Required application-level protection. Replace before starting.
PROSPECTOR_AUTH_USER=prospector
PROSPECTOR_AUTH_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Safety: keep 0. The production server refuses to create a fresh empty CRM by accident.
PROSPECTOR_ALLOW_EMPTY_DB=0

# Evolution API — keep the real API key only in /etc/prospector-dashboard.env (chmod 600).
EVOLUTION_API_URL=https://evolution.autocora.com.br
EVOLUTION_INSTANCE=Ana
EVOLUTION_API_KEY=CHANGE_ME
