# Prospector Client CMS — production environment example
#
# Never commit real values. Protected/non-local mode fails closed if
# PROSPECTOR_CMS_SECRET is absent.

PROSPECTOR_EDITOR_PUBLISH_MODE=git
PROSPECTOR_EDITOR_DEPLOY_REPO=
PROSPECTOR_EDITOR_DEPLOY_BASE_PATH=clientes
PROSPECTOR_EDITOR_DEPLOY_BRANCH=main

# HMAC signing secret for tenant sessions. Use a long random value.
PROSPECTOR_CMS_SECRET=

# Separate server-to-server credential for the operator dashboard.
# No browser/client receives this value.
PROSPECTOR_CMS_OPERATOR_SECRET=

# Public origin that serves /clientes/<slug>/admin/
PROSPECTOR_CMS_PUBLIC_BASE_URL=

# Durable server-side state directory for auth, drafts, reset tokens, and audit.
PROSPECTOR_CMS_DATA_DIR=

# Optional recovery-email transport.
PROSPECTOR_CMS_SMTP_HOST=
PROSPECTOR_CMS_SMTP_PORT=587
PROSPECTOR_CMS_SMTP_USERNAME=
PROSPECTOR_CMS_SMTP_PASSWORD=
PROSPECTOR_CMS_MAIL_FROM=

# Optional operator support WhatsApp.
PROSPECTOR_CMS_SUPPORT_WHATSAPP=
